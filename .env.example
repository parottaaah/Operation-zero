# ---------------------------------------------------------------------------
# OPERATION ZERO — local environment template
# Copy to .env and replace every value marked CHANGE_ME before running.
# ---------------------------------------------------------------------------
OZ_ENV=development
OZ_DEBUG=true
OZ_SERVICE_NAME=operation-zero-api
OZ_API_BASE_URL=http://localhost:8000

# --- Database ---------------------------------------------------------------
# Postgres for docker-compose / real deployments.
OZ_DATABASE_URL=postgresql+psycopg://oz:oz@localhost:5432/operation_zero
# SQLite is accepted for zero-dependency local development and tests:
# OZ_DATABASE_URL=sqlite:///./data/operation_zero.db

# --- Redis (rate limiting, cache, queue coordination) -----------------------
# Leave blank to use the in-process fallback (single-node development only).
OZ_REDIS_URL=redis://localhost:6379/0

# --- Auth -------------------------------------------------------------------
# CHANGE_ME: generate with: python -c "import secrets;print(secrets.token_urlsafe(48))"
OZ_JWT_SECRET=dev-only-insecure-secret-change-me
OZ_ACCESS_TOKEN_TTL_MINUTES=60
OZ_REFRESH_TOKEN_TTL_DAYS=14

# --- Secrets at rest --------------------------------------------------------
# CHANGE_ME: 32-byte url-safe base64 key:
#   python -c "from cryptography.fernet import Fernet;print(Fernet.generate_key().decode())"
OZ_ENCRYPTION_KEY=

# --- Web --------------------------------------------------------------------
OZ_CORS_ORIGINS=http://localhost:5173,http://localhost:3000
OZ_PUBLIC_WEB_URL=http://localhost:5173

# --- Limits -----------------------------------------------------------------
OZ_MAX_LOG_BATCH_EVENTS=500
OZ_MAX_LOG_PAYLOAD_BYTES=262144
OZ_MAX_LOG_QUERY_RANGE_DAYS=7
OZ_INGEST_RATE_LIMIT_PER_MINUTE=600
OZ_AUTH_RATE_LIMIT_PER_MINUTE=20
OZ_AI_RATE_LIMIT_PER_MINUTE=10
OZ_ALLOW_PRIVATE_HEALTH_CHECKS=false

# --- Background workers -----------------------------------------------------
# API container keeps this false; the worker container sets it true.
OZ_ENABLE_BACKGROUND_WORKERS=false
OZ_HEALTHCHECK_INTERVAL_SECONDS=60
OZ_ALERT_EVAL_INTERVAL_SECONDS=60

# --- GitHub integration (least privilege) -----------------------------------
OZ_GITHUB_CLIENT_ID=
OZ_GITHUB_CLIENT_SECRET=
OZ_GITHUB_WEBHOOK_SECRET=
OZ_GITHUB_OAUTH_SCOPES=read:user repo:status

# --- AI provider (optional — core workflows never depend on it) -------------
# none | openai_compatible. With "none" a deterministic local evidence
# summarizer is used so the workflow stays testable and offline-safe.
OZ_AI_PROVIDER=none
OZ_AI_BASE_URL=https://api.openai.com/v1
OZ_AI_API_KEY=
OZ_AI_MODEL=
OZ_AI_TIMEOUT_SECONDS=30
OZ_AI_PROMPT_VERSION=ai-investigation/v1

# --- Email notifications (optional; logs to console when unset) -------------
OZ_SMTP_HOST=
OZ_SMTP_PORT=587
OZ_SMTP_USERNAME=
OZ_SMTP_PASSWORD=
OZ_SMTP_STARTTLS=true
OZ_EMAIL_FROM=alerts@operation-zero.local

# --- Storage ----------------------------------------------------------------
OZ_REPORTS_DIR=./data/reports
OZ_TELEMETRY_DEFAULT_RETENTION_DAYS=30
